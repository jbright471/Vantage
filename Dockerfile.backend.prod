FROM python:3.14-slim@sha256:cea0e6040540fb2b965b6e7fb5ffa00871e632eef63719f0ea54bca189ce14a6

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY pyproject.toml alembic.ini ./
COPY migrations ./migrations
COPY backend ./backend
COPY agent ./agent
COPY config ./config

# Pip and its vendored build dependencies are not needed at runtime.
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir ".[postgres]" \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && groupadd --system --gid 10001 vantage \
    && useradd --system --uid 10001 --gid vantage --home-dir /nonexistent --shell /usr/sbin/nologin vantage \
    && mkdir -p /data \
    && chown -R vantage:vantage /data

USER 10001:10001

EXPOSE 8000

CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"]
