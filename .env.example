# Required for remote-agent authentication.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VANTAGE_BIND_ADDRESS=127.0.0.1
VANTAGE_AGENT_SHARED_TOKEN=
VANTAGE_AGENT_AUTH_MODE=bearer
VANTAGE_AGENT_KEY_ID=
VANTAGE_AGENT_ALLOWED_ACTIONS=read,capability_check,eval_attempt

# Optional. Required only for signed run-history audit bundles.
VANTAGE_AUDIT_SIGNING_KEY=
VANTAGE_AUDIT_KEY_ID=local-audit-key

# Optional. Protects /api/integrations/* for n8n, scripts, and external tools.
VANTAGE_EXTERNAL_API_TOKEN=

# Required. Protects the operator UI and all non-health control-plane APIs.
# Generate these independently; never reuse the agent or integration token.
VANTAGE_CONTROL_PLANE_TOKEN=
VANTAGE_SESSION_SIGNING_KEY=
VANTAGE_SESSION_MAX_AGE_SECONDS=28800
# Set to 1 when Vantage is served over HTTPS.
VANTAGE_SESSION_COOKIE_SECURE=0
VANTAGE_LLM_REQUESTS_PER_MINUTE=12
VANTAGE_LLM_MAX_CONCURRENCY=2
VANTAGE_EVAL_NUM_PREDICT=512
VANTAGE_LLM_MAX_RESPONSE_CHARS=65536

# Optional. Webhook dispatch targets for local automation.
VANTAGE_WEBHOOK_URL=
VANTAGE_SLACK_WEBHOOK_URL=
VANTAGE_DISCORD_WEBHOOK_URL=
VANTAGE_WEBHOOK_ALLOWED_HOSTS=
VANTAGE_WEBHOOK_ALLOW_PRIVATE_NETWORKS=0
VANTAGE_EMAIL_SMTP_HOST=
VANTAGE_EMAIL_SMTP_PORT=587
VANTAGE_EMAIL_SMTP_USERNAME=
VANTAGE_EMAIL_SMTP_PASSWORD=
VANTAGE_EMAIL_FROM=
VANTAGE_EMAIL_TO=
VANTAGE_EMAIL_USE_TLS=1
VANTAGE_REPORT_SCHEDULE_ENABLED=0
VANTAGE_REPORT_OUTPUT_DIR=reports

# Optional local Ollama endpoints visible from the backend container.
# For Docker Desktop, host.docker.internal usually reaches host services.
VANTAGE_LOCAL_OLLAMA_BASE_URLS=http://host.docker.internal:11400

# Optional. Seed safe synthetic nodes/runs/models for screenshots and first-time evaluation.
VANTAGE_DEMO_MODE=0
