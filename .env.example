# Required for remote-agent authentication.
# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VANTAGE_AGENT_SHARED_TOKEN=

# Optional local Ollama endpoints visible from the backend container.
# For Docker Desktop, host.docker.internal usually reaches host services.
VANTAGE_LOCAL_OLLAMA_BASE_URLS=http://host.docker.internal:11434
