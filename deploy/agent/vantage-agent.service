[Unit]
Description=Vantage Remote Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vantage-agent
Group=vantage-agent
WorkingDirectory=/opt/vantage
EnvironmentFile=/opt/vantage/vantage-agent.env
ExecStart=/opt/vantage/.venv/bin/python -m uvicorn agent.app.main:app --host 0.0.0.0 --port ${VANTAGE_AGENT_PORT}
Restart=always
RestartSec=5
SyslogIdentifier=vantage-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
